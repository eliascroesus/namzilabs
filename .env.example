# Copy to .env and fill in real values. NEVER commit .env.
# Neon Postgres connection string (pooled). From the Neon console → Connection Details.
DATABASE_URL="postgres://user:password@host.neon.tech/neondb?sslmode=require"

# Auth.js. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client for namzilabs.co (Google Cloud Console → Credentials).
# Authorized redirect URI: https://namzilabs.co/api/auth/callback/google
# For local dev also add:   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Inngest. Auto-injected by the Inngest Vercel integration in production;
# only needed locally if you use `npx inngest-cli dev` cloud sync.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# 32-byte key for AES-256-GCM encryption of stored integration credentials.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
